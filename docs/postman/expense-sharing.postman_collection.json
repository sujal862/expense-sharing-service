        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Rahul\"\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Create Ankit",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/users",
        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Ankit\"\n}", "options": {"raw": {"language": "json"}}}
      }
