      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/groups/{{chain_id}}/members",
        "body": {"mode": "raw", "raw": "{\n  \"user_id\": {{b}}\n}", "options": {"raw": {"language": "json"}}}
      }
