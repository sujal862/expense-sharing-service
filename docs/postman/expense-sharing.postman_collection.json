    {
      "name": "a owes b",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/expenses",
        "body": {"mode": "raw", "raw": "{\n  \"group_id\": {{chain_id}},\n  \"paid_by\": {{b}},\n  \"amount\": \"500.00\",\n  \"description\": \"Paid on behalf of another member\",\n  \"split_type\": \"custom\",\n  \"splits\": [\n    {\n      \"user_id\": {{a}},\n      \"amount\": \"500.00\"\n    }\n  ]\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "b owes c",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/expenses",
        "body": {"mode": "raw", "raw": "{\n  \"group_id\": {{chain_id}},\n  \"paid_by\": {{c}},\n  \"amount\": \"500.00\",\n  \"description\": \"Paid on behalf of another member\",\n  \"split_type\": \"custom\",\n  \"splits\": [\n    {\n      \"user_id\": {{b}},\n      \"amount\": \"500.00\"\n    }\n  ]\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Chain collapses to one suggestion",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/groups/{{chain_id}}/settlement-suggestions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const responseBody = pm.response.json();",
              "  pm.test(\"One simplified payment\", () => {",
              "    pm.expect(responseBody.payment_count).to.eql(1);",
              "    pm.expect(responseBody.transfers[0].debtor.user_id).to.eql(Number(pm.environment.get(\"a\")));",
              "    pm.expect(responseBody.transfers[0].creditor.user_id).to.eql(Number(pm.environment.get(\"c\")));",
              "  });",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "Record payment along simplified route",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/groups/{{chain_id}}/settlements",
        "body": {"mode": "raw", "raw": "{\n  \"paid_by\": {{a}},\n  \"paid_to\": {{c}},\n  \"amount\": \"500.00\"\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "All net balances zero; historical cycle remains",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/groups/{{chain_id}}/balances"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const responseBody = pm.response.json();",
              "  pm.test(\"Everyone settled\", () => pm.expect(responseBody.members.every(m => m.net_amount === \"0.00\")).to.be.true);",
              "  pm.test(\"Historical cycle is preserved\", () => pm.expect(responseBody.pairwise).to.have.lengthOf(3));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "Settled group has no suggestions",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/groups/{{chain_id}}/settlement-suggestions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const responseBody = pm.response.json();",
              "  pm.test(\"No suggestions remain\", () => pm.expect(responseBody.transfers).to.eql([]));",
              "})();"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(function () {",
          "  const expectedStatus = pm.info.requestName === \"Excess payment rejected\"",
          "    ? 409 : (pm.request.method === \"POST\" ? 201 : 200);",
          "  pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(expectedStatus));",
          "",
          "  // Save generated IDs for later requests in the demo.",
          "  const idVariables = {",
          "    \"Create Mohit\": \"a\", \"Create Rahul\": \"b\",",
          "    \"Create Ankit\": \"c\", \"Create Priya\": \"d\",",
          "    \"Create Goa group\": \"group_id\", \"Create chain group\": \"chain_id\",",
          "    \"Dinner split among original three members\": \"dinner_id\"",
          "  };",
          "  const variable = idVariables[pm.info.requestName];",
          "  if (variable && pm.response.code === 201) {",
          "    pm.environment.set(variable, pm.response.json().id);",
          "  }",
          "})();"
        ]
      }
    }
  ]
