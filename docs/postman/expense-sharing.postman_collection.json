    {
      "name": "List users",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/users?limit=20&offset=0"
      }
    },
    {
      "name": "Create Goa group",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/groups",
        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Goa Postman Demo\"\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Add a to Goa",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/members",
        "body": {"mode": "raw", "raw": "{\n  \"user_id\": {{a}}\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Add b to Goa",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/members",
        "body": {"mode": "raw", "raw": "{\n  \"user_id\": {{b}}\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Add c to Goa",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/members",
        "body": {"mode": "raw", "raw": "{\n  \"user_id\": {{c}}\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "List members",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/members"
      }
    },
    {
      "name": "Dinner split among original three members",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/expenses",
        "body": {"mode": "raw", "raw": "{\n  \"group_id\": {{group_id}},\n  \"paid_by\": {{a}},\n  \"amount\": \"1200.00\",\n  \"description\": \"Dinner\"\n}", "options": {"raw": {"language": "json"}}}
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const responseBody = pm.response.json();",
              "  pm.test(\"Three saved shares\", () => pm.expect(responseBody.splits).to.have.lengthOf(3));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "Taxi paid by a different member",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/expenses",
        "body": {"mode": "raw", "raw": "{\n  \"group_id\": {{group_id}},\n  \"paid_by\": {{b}},\n  \"amount\": \"600.00\",\n  \"description\": \"Taxi\"\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Priya joins after dinner and taxi",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/members",
        "body": {"mode": "raw", "raw": "{\n  \"user_id\": {{d}}\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Custom subset excludes payer",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/expenses",
        "body": {"mode": "raw", "raw": "{\n  \"group_id\": {{group_id}},\n  \"paid_by\": {{c}},\n  \"amount\": \"300.00\",\n  \"description\": \"Activities\",\n  \"split_type\": \"custom\",\n  \"splits\": [\n    {\n      \"user_id\": {{b}},\n      \"amount\": \"100.00\"\n    },\n    {\n      \"user_id\": {{d}},\n      \"amount\": \"200.00\"\n    }\n  ]\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "History preserves original participants",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/expenses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const responseBody = pm.response.json();",
              "  const dinner = responseBody.items.find(e => e.id === Number(pm.environment.get(\"dinner_id\")));",
              "  pm.test(\"New member did not inherit dinner\", () => {",
              "    pm.expect(dinner.splits).to.have.lengthOf(3);",
              "    pm.expect(dinner.splits.map(s => s.user_id)).not.to.include(Number(pm.environment.get(\"d\")));",
              "  });",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "Balances before partial payment",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/balances"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const responseBody = pm.response.json();",
              "  pm.test(\"Mohit should receive 600\", () => pm.expect(responseBody.members.find(m => m.user_id === Number(pm.environment.get(\"a\"))).net_amount).to.eql(\"600.00\"));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "Smart suggestions before partial payment",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/settlement-suggestions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const responseBody = pm.response.json();",
              "  pm.test(\"Three suggestions\", () => pm.expect(responseBody.payment_count).to.eql(3));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "Record partial real-world payment",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/groups/{{group_id}}/settlements",
        "body": {"mode": "raw", "raw": "{\n  \"paid_by\": {{c}},\n  \"paid_to\": {{a}},\n  \"amount\": \"150.00\"\n}", "options": {"raw": {"language": "json"}}}
      }
