{
  "info": {
    "name": "Expense Sharing Service - Complete Demo",
    "_postman_id": "4ca67a12-98ce-4a8e-8bd5-e1bbbfeec784",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order using the supplied environment. Creates fresh synthetic records on each run. Money inputs are INR decimal strings. Includes equal/custom splits, late joiner, partial payment, and simplified route."
  },
  "item": [
    {
      "name": "01 Liveness",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "02 Readiness",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/ready"
      }
    },
    {
      "name": "Create Mohit",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/api/v1/users",
        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Mohit\"\n}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Create Rahul",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
